      "name": "Start locally",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "parameters": {}
    },
    {
      "id": "ffdfdb64-72b9-4870-903e-80059df09611",
      "name": "Set API URL",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
