            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "6470d524-d986-4e36-8a7f-29a830be54fd",
      "name": "Create run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.apiBaseUrl + '/runs' }}",
        "options": { "timeout": 10000 }
      }
    },
    {
      "id": "3b62c256-cb8d-4ad9-b53a-25e0dca44713",
      "name": "Return run ID",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [660, 0],
      "parameters": {
        "respondWith": "firstIncomingItem",
        "options": { "responseCode": 202 }
      }
    },
    {
      "id": "ea963063-5851-4e8b-b04e-a941100ccd9c",
      "name": "Prepare requirements",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 0],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const runId = $input.first().json.runId;\nconst apiBaseUrl = $('Set API URL').first().json.apiBaseUrl;\nconst questionIds = [\n  'employee-saml-sign-in',\n  'https-account-event-webhook',\n  'first-attempt-60-seconds',\n];\nreturn questionIds.map((questionId) => ({ json: { runId, apiBaseUrl, questionId } }));"
      }
    },
    {
      "id": "e14c0755-17e9-4984-869b-cd36a6a5de09",
      "name": "Assess requirement",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 0],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "={{ $json.apiBaseUrl + '/runs/' + $json.runId + '/assessments' }}",
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            { "name": "questionId", "value": "={{ $json.questionId }}" }
          ]
        },
        "options": { "timeout": 45000 }
      }
    },
    {
      "id": "d8c3661d-455d-4a56-a232-66878d304622",
      "name": "Check three results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 0],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const results = $input.all().map((item) => item.json);\nconst questionIds = new Set(results.map((result) => result.questionId));\nconst runIds = new Set(results.map((result) => result.runId));\nconst revisions = new Set(results.map((result) => result.sourceRevisionId));\nif (results.length !== 3 || questionIds.size !== 3 || runIds.size !== 1 || revisions.size !== 1) {\n  throw new Error('The three requirements did not complete in one run');\n}\nreturn [{ json: { runId: results[0].runId, apiBaseUrl: $('Set API URL').first().json.apiBaseUrl } }];"
      }
    },
    {
      "id": "8eb7ca25-f3b0-4c58-a2d3-91a789081c22",
      "name": "Read saved assessments",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1540, 0],
      "parameters": {
        "url": "={{ $json.apiBaseUrl + '/runs/' + $json.runId + '/assessments' }}",
        "options": { "timeout": 10000 }
      }
    },
    {
      "id": "2c0aa171-d02b-428e-b3a9-92c9c87a16f3",
      "name": "Confirm saved assessments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1760, 0],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const saved = $input.first().json;\nconst questionIds = new Set(saved.assessments.map((assessment) => assessment.questionId));\nif (saved.assessments.length !== 3 || questionIds.size !== 3 || saved.runId !== $('Check three results').first().json.runId) {\n  throw new Error('The saved assessments are incomplete');\n}\nreturn $input.all();"
      }
    }
  ],
  "connections": {
    "Start assessment": { "main": [[{ "node": "Set API URL", "type": "main", "index": 0 }]] },
    "Start locally": { "main": [[{ "node": "Set API URL", "type": "main", "index": 0 }]] },
