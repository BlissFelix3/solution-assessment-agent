{
  "id": "ce4e947b-7b86-4e35-a538-d562eaf6a432",
  "name": "Complete solution assessment",
  "nodes": [
    {
      "id": "a4193794-1026-477e-9ce3-e834511b3d86",
      "name": "Start assessment",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 0],
      "webhookId": "a1efc51a-7360-429b-9c42-f2b1be260260",
      "credentials": {
        "httpHeaderAuth": {
          "id": "90a7655c-28d6-4696-9198-85313065073b",
          "name": "Demo start webhook"
        }
      },
      "parameters": {
        "httpMethod": "POST",
        "path": "solution-assessments",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "0e853e90-1c58-49b1-9ada-3e8bcd43fce4",
      "name": "Start locally",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, -130],
      "parameters": {}
    },
    {
      "id": "ffdfdb64-72b9-4870-903e-80059df09611",
      "name": "Set API URL",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [180, 0],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "api-base-url",
              "name": "apiBaseUrl",
              "value": "http://127.0.0.1:3000",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "6470d524-d986-4e36-8a7f-29a830be54fd",
      "name": "Create run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [360, 0],
      "credentials": {
        "httpHeaderAuth": {
          "id": "59191026-e284-4d79-bbe4-03ceb3531b07",
          "name": "API worker access"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "={{ $json.apiBaseUrl + '/runs' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            { "name": "executionId", "value": "={{ $execution.id }}" },
            { "name": "requirements", "value": "={{ $json.body?.requirements }}" },
            { "name": "collectionId", "value": "={{ $json.body?.collectionId }}" },
            { "name": "retrievalMode", "value": "={{ $json.body?.retrievalMode }}" }
          ]
        },
        "options": { "timeout": 10000 }
      }
    },
    {
      "id": "3b62c256-cb8d-4ad9-b53a-25e0dca44713",
      "name": "Return run ID",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [540, 0],
      "parameters": {
        "respondWith": "firstIncomingItem",
        "options": { "responseCode": 202 }
      }
    },
    {
      "id": "ea963063-5851-4e8b-b04e-a941100ccd9c",
      "name": "Prepare requirements",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 0],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const run = $input.first().json;\nconst apiBaseUrl = $('Set API URL').first().json.apiBaseUrl;\nreturn run.requirements.map(({ id: questionId }) => ({ json: { runId: run.runId, apiBaseUrl, questionId } }));"
      }
    },
    {
      "id": "e14c0755-17e9-4984-869b-cd36a6a5de09",
      "name": "Assess requirement",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 0],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "59191026-e284-4d79-bbe4-03ceb3531b07",
          "name": "API worker access"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "={{ $json.apiBaseUrl + '/runs/' + $json.runId + '/assessments' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            { "name": "questionId", "value": "={{ $json.questionId }}" }
          ]
        },
        "options": { "timeout": 45000 }
      }
    },
    {
      "id": "d8c3661d-455d-4a56-a232-66878d304622",
      "name": "Check results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [0, 220],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const results = $input.all().map((item) => item.json);\nconst run = $('Create run').first().json;\nconst questionIds = new Set(results.map((result) => result.questionId));\nif (results.length !== run.requirements.length || questionIds.size !== run.requirements.length ||\n  !run.requirements.every((requirement) => questionIds.has(requirement.id)) ||\n  results.some((result) => result.runId !== run.runId || result.sourceRevisionId !== run.sourceRevisionId)) {\n  throw new Error('The submitted requirements did not complete in one run');\n}\nreturn [{ json: { runId: run.runId, apiBaseUrl: $('Set API URL').first().json.apiBaseUrl } }];"
      }
    },
    {
      "id": "8eb7ca25-f3b0-4c58-a2d3-91a789081c22",
      "name": "Read saved assessments",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [180, 220],
      "parameters": {
        "url": "={{ $json.apiBaseUrl + '/runs/' + $json.runId + '/assessments' }}",
        "options": { "timeout": 10000 }
      }
    },
    {
      "id": "2c0aa171-d02b-428e-b3a9-92c9c87a16f3",
      "name": "Confirm saved assessments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [360, 220],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const saved = $input.first().json;\nconst run = $('Create run').first().json;\nconst questionIds = new Set(saved.assessments.map((assessment) => assessment.questionId));\nif (saved.assessments.length !== run.requirements.length || questionIds.size !== run.requirements.length ||\n  !run.requirements.every((requirement) => questionIds.has(requirement.id)) || saved.runId !== run.runId) {\n  throw new Error('The saved assessments are incomplete');\n}\nreturn $input.all();"
      }
    },
    {
      "id": "60c3ba6b-f574-4d2d-9d06-9ec74d08c61c",
      "name": "Create dossier",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [540, 220],
      "credentials": {
        "httpHeaderAuth": {
          "id": "59191026-e284-4d79-bbe4-03ceb3531b07",
          "name": "API worker access"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "={{ $('Set API URL').first().json.apiBaseUrl + '/runs/' + $json.runId + '/dossier' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": { "timeout": 10000 }
      }
    },
    {
      "id": "bc360932-790d-4d25-a024-bf8ba62896dc",
      "name": "Complete run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 220],
      "credentials": {
        "httpHeaderAuth": {
          "id": "59191026-e284-4d79-bbe4-03ceb3531b07",
          "name": "API worker access"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "={{ $('Set API URL').first().json.apiBaseUrl + '/runs/' + $json.runId + '/complete' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": { "timeout": 10000 }
      }
    },
    {
      "id": "e0d351fe-e84b-4029-8ee5-3d54ab02770b",
      "name": "Run failed",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [900, 220],
      "parameters": {}
    },
    {
      "id": "9e155e0f-499f-4ce9-b9bc-9563e1781363",
      "name": "Identify failed execution",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1080, 220],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const executionId = $input.first().json.execution?.id;\nreturn executionId ? [{ json: { executionId } }] : [];"
      }
    },
    {
      "id": "8b5b6c55-4742-4bbb-8aa9-f191993772d1",
      "name": "Mark failed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1260, 220],
      "credentials": {
        "httpHeaderAuth": {
          "id": "59191026-e284-4d79-bbe4-03ceb3531b07",
          "name": "API worker access"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://127.0.0.1:3000/runs/executions/' + $json.executionId + '/fail' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": { "timeout": 10000 }
      }
    }
  ],
  "connections": {
