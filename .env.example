# Server only. Copy to .env; never commit actual keys.
DATABASE_URL=postgresql://localhost/solution_assessment
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional fallback providers; leave blank to disable.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Match these tokens to the n8n Header Auth credentials.
INTERNAL_API_TOKEN=
N8N_START_TOKEN=
N8N_START_WEBHOOK_URL=http://127.0.0.1:5678/webhook/solution-assessments
DEMO_RUNS_PER_HOUR=20
