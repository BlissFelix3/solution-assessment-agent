{
  "name": "@solution-assessment/api",
  "private": true,
  "type": "module",
  "scripts": {
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:seed": "node --import tsx scripts/seed.ts",
    "models:warm": "node --import tsx scripts/warm-models.ts",
    "eval:retrieval": "node --import tsx scripts/evaluate-retrieval.ts",
    "eval:hybrid": "node --import tsx scripts/evaluate-hybrid.ts",
    "eval:answers": "node --import tsx scripts/evaluate-answers.ts",
    "start": "node --import tsx src/main.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "flatted": "3.4.2",
    "onnxruntime-node": "1.21.0",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
